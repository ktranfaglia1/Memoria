// Cloudflare Workers config for the Memoria web app and API.
// IDs in this file are not secrets: using them still requires an API token.
// Secrets go in `wrangler secret put <NAME>` (production) or .dev.vars (local).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "memoria",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    {
      "pattern": "memoria.kyletranfaglia.top",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "memoria",
      "database_id": "7f03e7e0-ffca-4c67-b296-e1c74f45ab83",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "memoria",
    },
  ],
}
