---
import BaseLayout from "../layouts/BaseLayout.astro";
import SignOutButton from "../components/SignOutButton.astro";
import Uploader from "../components/Uploader.tsx";
import { db } from "../lib/server/db.ts";
import { librarySummary } from "../lib/server/library.ts";

const user = Astro.locals.user!;
const summary = await librarySummary(db);

const gb = (bytes: number) =>
  (bytes / 1024 ** 3).toFixed(bytes < 1024 ** 3 ? 2 : 1);
const lastSync = summary.agentLastSeen
  ? new Intl.DateTimeFormat("en-US", {
      dateStyle: "medium",
      timeStyle: "short",
      timeZone: "America/New_York",
    }).format(summary.agentLastSeen)
  : "never";
---

<BaseLayout>
  <main class="mx-auto max-w-xl px-4 py-8 sm:px-6">
    <header class="flex items-center justify-between gap-4">
      <h1 class="font-serif text-3xl">Memoria</h1>
      <div class="text-fg-muted flex items-center gap-3 text-sm">
        <span class="truncate">{user.name}</span>
        <SignOutButton />
      </div>
    </header>

    <dl class="border-line bg-surface mt-6 grid grid-cols-2 gap-px overflow-hidden rounded-xl border">
      <div class="p-4">
        <dt class="text-fg-muted text-xs tracking-wide uppercase">
          Saved on home drive
        </dt>
        <dd class="mt-1 text-2xl font-semibold">{summary.onDrive}</dd>
      </div>
      <div class="p-4">
        <dt class="text-fg-muted text-xs tracking-wide uppercase">
          Waiting for the PC
        </dt>
        <dd class="mt-1 text-2xl font-semibold">{summary.inCloud}</dd>
      </div>
      <div class="p-4">
        <dt class="text-fg-muted text-xs tracking-wide uppercase">
          Cloud inbox
        </dt>
        <dd class="mt-1 text-sm">
          {gb(summary.inboxBytes)} of {gb(summary.inboxCapBytes)} GB
        </dd>
      </div>
      <div class="p-4">
        <dt class="text-fg-muted text-xs tracking-wide uppercase">
          PC last synced
        </dt>
        <dd class="mt-1 text-sm">{lastSync}</dd>
      </div>
    </dl>

    <Uploader client:load />
  </main>
</BaseLayout>
