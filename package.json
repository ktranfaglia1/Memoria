{
  "name": "memoria",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @memoria/web dev",
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "deploy": "pnpm --filter @memoria/web run deploy"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
